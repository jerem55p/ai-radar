<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}AI Radar{% endblock %}</title>
<meta name="description" content="Le top des dépôts GitHub open source d'IA qui montent le plus fort, chaque matin.">
<style>
:root {
  --bg: #f6f7f9; --card: #ffffff; --text: #16191d; --muted: #5d6671; --border: #e2e5e9;
  --accent: #2f6df6; --accent-soft: #e7eefe; --good: #12805c; --bad: #c0392b; --warn: #a76a00;
  --podium: #fff7e0; --podium-border: #f0d78a;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #101317; --card: #181c21; --text: #e9ecef; --muted: #98a2ad; --border: #2a3038;
    --accent: #7aa2ff; --accent-soft: #1d2a45; --good: #4cc79a; --bad: #ff8a7a; --warn: #e3b04b;
    --podium: #2a2410; --podium-border: #5b4d1c;
  }
}
:root[data-theme="dark"] {
  --bg: #101317; --card: #181c21; --text: #e9ecef; --muted: #98a2ad; --border: #2a3038;
  --accent: #7aa2ff; --accent-soft: #1d2a45; --good: #4cc79a; --bad: #ff8a7a; --warn: #e3b04b;
  --podium: #2a2410; --podium-border: #5b4d1c;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
.wrap { max-width: 880px; margin: 0 auto; padding: 0 16px 48px; }
header.top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 20px 0 8px; flex-wrap: wrap; }
header.top h1 { margin: 0; font-size: 1.5rem; } header.top h1 small { font-weight: 400; color: var(--muted); font-size: 1rem; display: block; }
button.theme { border: 1px solid var(--border); background: var(--card); color: var(--text); border-radius: 999px; padding: 6px 12px; cursor: pointer; font: inherit; font-size: .9rem; }
nav.links { display: flex; gap: 14px; flex-wrap: wrap; font-size: .95rem; margin: 4px 0 12px; }
.muted { color: var(--muted); } .small { font-size: .85rem; }
.legend { font-size: .85rem; color: var(--muted); margin: 8px 0 16px; }
.chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0 20px; }
.chip { border: 1px solid var(--border); background: var(--card); color: var(--text); border-radius: 999px; padding: 6px 12px; cursor: pointer; font: inherit; font-size: .88rem; }
.chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
h2 { font-size: 1.15rem; margin: 28px 0 10px; }
.card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 14px 16px; margin: 0 0 12px; }
.card.podium { background: var(--podium); border-color: var(--podium-border); }
.card[hidden] { display: none; }
.card .head { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
.rank { font-weight: 700; color: var(--muted); min-width: 2.2em; }
.card .name { font-weight: 650; font-size: 1.05rem; overflow-wrap: anywhere; }
.cat { font-size: .82rem; color: var(--muted); margin-top: 2px; }
.one { margin: 6px 0 4px; font-weight: 500; }
.badges { display: flex; gap: 6px; flex-wrap: wrap; margin: 6px 0; }
.badge { font-size: .76rem; border-radius: 999px; padding: 2px 9px; background: var(--accent-soft); color: var(--accent); white-space: nowrap; }
.badge.up { color: var(--good); } .badge.down { color: var(--bad); } .badge.warn, .badge.stale { color: var(--warn); }
.nums { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 8px 0; font-size: .92rem; }
.nums b { font-variant-numeric: tabular-nums; }
.meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: .84rem; color: var(--muted); margin-top: 6px; }
.row { display: flex; gap: 16px; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; }
.spark { display: block; } .spark .bar { fill: var(--accent); opacity: .55; } .spark .bar-last { opacity: 1; } .spark .bar-none { fill: var(--border); }
.why { font-size: .92rem; color: var(--muted); margin: 4px 0; }
ul.plain { list-style: none; padding: 0; margin: 0; } ul.plain li { padding: 8px 0; border-bottom: 1px solid var(--border); }
ul.plain li:last-child { border-bottom: 0; }
footer { margin-top: 36px; font-size: .82rem; color: var(--muted); }
@media (max-width: 520px) { body { font-size: 15px; } .card { padding: 12px; } }
</style>
<script>
(function () {
  try { var t = localStorage.getItem("theme"); if (t) document.documentElement.setAttribute("data-theme", t); } catch (e) {}
})();
</script>
</head>
<body>
<div class="wrap">
  <header class="top">
    <h1>🤖 AI Radar<small>{% block subtitle %}{% endblock %}</small></h1>
    <button class="theme" id="theme" type="button" aria-label="Changer de thème">🌓 Thème</button>
  </header>
  {% block body %}{% endblock %}
  <footer>Généré le {{ generated }} · Données : GitHub, Hacker News · <a href="index.html">Dernier rapport</a></footer>
</div>
<script>
document.getElementById("theme").addEventListener("click", function () {
  var cur = document.documentElement.getAttribute("data-theme");
  var dark = cur ? cur === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
  var next = dark ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  try { localStorage.setItem("theme", next); } catch (e) {}
});
{% block script %}{% endblock %}
</script>
</body>
</html>
